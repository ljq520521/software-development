# ./docker.sh init 会自动生成 .env.docker 及随机密码；不要提交真实凭据。
# 也可以复制本文件为 .env.docker 并填写以下三个密码。
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8081
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
COOKIE_SECURE=false
FORWARD_HEADERS_STRATEGY=none

# 自动邮件；SMTP_HOST 留空时邮件仅保存到 MySQL email_outbox。
PUBLIC_BASE_URL=http://127.0.0.1:8081
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com
SMTP_STARTTLS=true
